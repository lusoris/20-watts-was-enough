    "workstation:fixture-012": "node experiments/workstation/fixture-012/runner.mjs",
    "workstation:fixture-019": "node experiments/workstation/fixture-019/runner.mjs",
    "workstation:fixture-022": "node experiments/workstation/fixture-022/runner.mjs",
    "workstation:fixture-023": "node experiments/workstation/fixture-023/runner.mjs",
    "workstation:fixture-024": "node experiments/workstation/fixture-024/runner.mjs",
    "workstation:fixture-025": "node experiments/workstation/fixture-025/runner.mjs",
    "workstation:fixture-026": "node experiments/workstation/fixture-026/runner.mjs",
    "workstation:fixture-027": "node experiments/workstation/fixture-027/runner.mjs",
    "workstation:fixture-029": "node experiments/workstation/fixture-029/suite-runner.mjs",
    "test:workstation:fixture-022": "node --test --experimental-test-isolation=none experiments/workstation/fixture-022/*.test.mjs",
    "test:workstation:fixture-023": "node --test --experimental-test-isolation=none experiments/workstation/fixture-023/*.test.mjs",
    "test:workstation:fixture-024": "node --test --experimental-test-isolation=none experiments/workstation/fixture-024/*.test.mjs",
    "test:workstation:fixture-025": "node --test --experimental-test-isolation=none experiments/workstation/fixture-025/*.test.mjs",
    "test:workstation:fixture-026": "node --test --experimental-test-isolation=none --test-concurrency=1 experiments/workstation/fixture-026/*.test.mjs",
    "test:workstation:fixture-026:foundations": "node --test --experimental-test-isolation=none --test-concurrency=1 experiments/workstation/fixture-026/rsd-t02-fixed-instance-runner.test.mjs experiments/workstation/fixture-026/rsd-t02-null-maturation-contract.test.mjs experiments/workstation/fixture-026/rsd-t02-null-prototypes.test.mjs experiments/workstation/fixture-026/rsd-t02-null-prototype-adapter.test.mjs experiments/workstation/fixture-026/rsd-t02-holm4.test.mjs experiments/workstation/fixture-026/rsd-t02-power-plan.test.mjs",
    "test:workstation:fixture-026:execution-v52": "node --test --experimental-test-isolation=none --test-concurrency=1 experiments/workstation/fixture-026/rsd-t02-run-lock.test.mjs experiments/workstation/fixture-026/rsd-t02-fixed-instance-durable-store.test.mjs experiments/workstation/fixture-026/rsd-t02-fixed-instance-isolated-durable-runner.test.mjs experiments/workstation/fixture-026/rsd-t02-public-development-population-runner.test.mjs experiments/workstation/fixture-026/rsd-t02-public-development-isolated-durable-population-runner.test.mjs experiments/workstation/fixture-026/rsd-t02-pilot-transcript-calibration.test.mjs",
    "test:workstation:fixture-027": "node --test --experimental-test-isolation=none experiments/workstation/fixture-027/*.test.mjs",
    "test:workstation:fixture-029": "node --test --experimental-test-isolation=none experiments/workstation/fixture-029/*.test.mjs",
    "workstation:fixture-012:physical": "node experiments/workstation/fixture-012/workstation-cli.mjs",
    "generate:plots": "node scripts/generate-plots.mjs && node scripts/generate-field-coverage.mjs",
    "prepare:reader-artifacts": "node scripts/prepare-reader-artifacts.mjs",
    "generate:coverage": "node scripts/generate-field-coverage.mjs",
    "validate:coverage": "node scripts/generate-field-coverage.mjs --check",
    "generate:taxonomies": "python scripts/import-science-taxonomies.py && node scripts/generate-taxonomy-depth.mjs",
    "generate:third-party-notices": "node scripts/generate-third-party-notices.mjs",
    "validate:taxonomies": "node scripts/validate-science-taxonomies.mjs && node scripts/generate-taxonomy-depth.mjs --check",
    "generate:book-pdf": "node scripts/generate-book-pdf.mjs",
    "validate:book-pdf": "node scripts/validate-book-pdf.mjs",
    "audit:tests": "node scripts/audit-test-coverage.mjs",
    "check:test-coverage": "node scripts/audit-test-coverage.mjs --check"
