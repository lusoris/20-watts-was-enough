{
  "name": "20-watts-was-enough",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run validate:book-pdf && vinext build",
    "start": "vinext start",
    "test": "npm run lint && npm run validate:docs && npm run validate:coverage && npm run validate:taxonomies && npm run validate:math && npm run validate:workstation && npm run test:workstation && npm run check:test-coverage && npm run test:readiness && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern tmp",
    "validate:docs": "pwsh -File scripts/validate-docs.ps1",
    "validate:math": "node scripts/validate-math.mjs",
    "format:math": "node scripts/normalize-math-delimiters.mjs --write",
    "validate:workstation": "node scripts/validate-workstation.mjs",
    "test:workstation": "node --test --test-isolation=none experiments/workstation/**/*.test.mjs",
    "test:readiness": "node --test --test-isolation=none scripts/readiness-summary.test.mjs",
    "workstation:candidate-010": "node experiments/workstation/candidate-010/runner.mjs",
    "workstation:fixture-007": "node experiments/workstation/fixture-007/runner.mjs",
    "workstation:fixture-012": "node experiments/workstation/fixture-012/runner.mjs",
    "workstation:fixture-019": "node experiments/workstation/fixture-019/runner.mjs",
    "workstation:fixture-022": "node experiments/workstation/fixture-022/runner.mjs",
    "workstation:fixture-023": "node experiments/workstation/fixture-023/runner.mjs",
    "workstation:fixture-024": "node experiments/workstation/fixture-024/runner.mjs",
    "workstation:fixture-025": "node experiments/workstation/fixture-025/runner.mjs",
    "workstation:fixture-027": "node experiments/workstation/fixture-027/runner.mjs",
    "test:workstation:fixture-022": "node --test --test-isolation=none experiments/workstation/fixture-022/*.test.mjs",
    "test:workstation:fixture-023": "node --test --test-isolation=none experiments/workstation/fixture-023/*.test.mjs",
    "test:workstation:fixture-024": "node --test --test-isolation=none experiments/workstation/fixture-024/*.test.mjs",
    "test:workstation:fixture-025": "node --test --test-isolation=none experiments/workstation/fixture-025/*.test.mjs",
    "test:workstation:fixture-027": "node --test --test-isolation=none experiments/workstation/fixture-027/*.test.mjs",
    "workstation:fixture-012:physical": "node experiments/workstation/fixture-012/workstation-cli.mjs",
    "generate:plots": "node scripts/generate-plots.mjs && node scripts/generate-field-coverage.mjs",
    "generate:coverage": "node scripts/generate-field-coverage.mjs",
    "validate:coverage": "node scripts/generate-field-coverage.mjs --check",
    "generate:taxonomies": "python scripts/import-science-taxonomies.py && node scripts/generate-taxonomy-depth.mjs",
    "validate:taxonomies": "node scripts/validate-science-taxonomies.mjs && node scripts/generate-taxonomy-depth.mjs --check",
    "generate:book-pdf": "node scripts/generate-book-pdf.mjs",
    "validate:book-pdf": "node scripts/validate-book-pdf.mjs",
    "audit:tests": "node scripts/audit-test-coverage.mjs",
    "check:test-coverage": "node scripts/audit-test-coverage.mjs --check"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "mermaid": "^11.16.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "6.15.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "es-module-lexer": "2.1.0",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
