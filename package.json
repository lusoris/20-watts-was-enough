    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern tmp",
    "validate:policy": "node scripts/validate-engineering-policy.mjs",
    "test:policy": "node --test --experimental-test-isolation=none scripts/engineering-policy.test.mjs",
    "prepare:release": "node scripts/prepare-release-assets.mjs",
    "test:release": "node --test --experimental-test-isolation=none scripts/prepare-release-assets.test.mjs scripts/lib/pdf-metadata.test.mjs",
