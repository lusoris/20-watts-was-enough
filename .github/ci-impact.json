      ]
    },
    {
      "id": "workstation-fixture-024",
      "paths": [
        "experiments/workstation/fixture-024/**",
        "experiments/workstation/manifests/fixture-024.json"
      ],
      "lanes": [
        "workstation-fixture-024"
      ]
    },
    {
      "id": "workstation-fixture-025",
      "paths": [
        "experiments/workstation/fixture-025/**",
        "experiments/workstation/manifests/fixture-025.json"
      ],
      "lanes": [
        "workstation-fixture-025"
      ]
    },
    {
      "id": "workstation-fixture-026",
      "paths": [
        "experiments/workstation/fixture-026/**",
        "experiments/workstation/manifests/fixture-026.json"
      ],
      "lanes": [
        "workstation-fixture-026"
      ]
    },
    {
      "id": "workstation-fixture-027",
      "paths": [
        "experiments/workstation/fixture-027/**",
        "experiments/workstation/manifests/fixture-027.json"
      ],
      "lanes": [
        "workstation-fixture-027"
      ]
    },
    {
      "id": "workstation-fixture-029",
      "paths": [
        "experiments/workstation/fixture-029/**",
        "experiments/workstation/manifests/fixture-029.json"
      ],
      "lanes": [
        "workstation-fixture-029"
      ]
    }
  ]
}
