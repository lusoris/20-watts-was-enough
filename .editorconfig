root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs,ts,tsx,css,json,jsonc,yaml,yml,toml,bib}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown hard line breaks are present in canonical research records.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
