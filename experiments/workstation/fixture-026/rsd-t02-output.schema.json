          {
            "properties": {
              "recipe_id": { "const": "M-RECEPTOR-MEMORY" },
              "equation_id": { "const": "t02-channel-local-reference" },
              "property_vector": { "properties": {
                "drive_transform": { "const": "affine-fold" },
                "reported_output_feedback_edge": { "const": false },
                "channel_local_state": { "const": true },
                "causal_memory": { "const": true }
              } },
              "full_panel_equivalence_class": { "const": "E-CHANNEL-LOCAL-MEMORY" }
