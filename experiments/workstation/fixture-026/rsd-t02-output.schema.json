          },
          {
            "properties": {
              "recipe_id": { "const": "M-STATIC-HIGHPASS" },
              "equation_id": { "const": "t02-static-affine-highpass" },
              "property_vector": { "properties": {
                "drive_transform": { "const": "affine-fold" },
                "reported_output_feedback_edge": { "const": false },
                "channel_local_state": { "const": false },
                "causal_memory": { "const": true }
              } },
              "full_panel_equivalence_class": { "const": "E-AFFINE-INPUT-MEMORY" }
            }
          },
          {
            "properties": {
              "recipe_id": { "const": "M-LOG-HIGHPASS" },
              "equation_id": { "const": "t02-log-difference-highpass" },
              "property_vector": { "properties": {
                "drive_transform": { "const": "log-fold" },
                "reported_output_feedback_edge": { "const": false },
                "channel_local_state": { "const": false },
                "causal_memory": { "const": true }
              } },
              "full_panel_equivalence_class": { "const": "E-LOG-INPUT-MEMORY" }
