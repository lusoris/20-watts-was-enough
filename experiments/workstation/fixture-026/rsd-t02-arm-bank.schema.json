{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://20-watts-was-enough.local/schemas/fixture-026.rsd-t02-arm-bank.v1.schema.json",
  "title": "Fixture 026 RSD-T02 pre-evaluator whole-system arm commitment",
  "type": "object",
  "additionalProperties": false,
  "x-runtime-validator": {
    "module": "rsd-t02-arm-bank.mjs",
    "export": "assertFixture026RsdT02ArmCommitment",
    "version_export": "FIXTURE_026_RSD_T02_ARM_BANK_VERSION",
    "contract_version": "fixture-026.rsd-t02-arm-bank.v1",
    "test": "rsd-t02-arm-bank.test.mjs"
  },
  "required": [
    "schema", "contract_version", "artifact", "track", "profile", "partition",
    "active_arm_ids", "inactive_arm_ids", "policy_artifact_sha256",
    "policy_config_sha256", "common_caps_sha256", "packet_records", "authority",
    "comparison_inference_permitted", "claim_eligible", "result_label", "no_result",
    "commitment_sha256"
