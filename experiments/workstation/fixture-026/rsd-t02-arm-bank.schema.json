    "inactiveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm_id", "system_packet_sha256", "action", "reason_codes"],
      "properties": {
        "arm_id": { "enum": ["A-RAW", "B-STATIC-DIV", "B-STREAM", "B-LOG-RATIO", "B-DIFFERENCE", "C-DUAL"] },
        "system_packet_sha256": { "$ref": "#/$defs/hash" },
        "action": { "const": "abstain" },
        "reason_codes": { "const": ["not-in-bounded-primary-arm-bank"] }
      }
    },
    "packetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_ordinal", "seed", "system_slot", "system_packet_sha256", "system_packet_utf8_bytes", "active_arm_responses", "inactive_arm_responses"],
      "properties": {
        "packet_ordinal": { "type": "integer", "minimum": 0 },
        "seed": { "$ref": "#/$defs/seed" },
        "system_slot": { "type": "integer", "minimum": 0, "maximum": 4 },
        "system_packet_sha256": { "$ref": "#/$defs/hash" },
        "system_packet_utf8_bytes": { "type": "integer", "minimum": 1 },
        "active_arm_responses": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "$ref": "#/$defs/armResponse" }
        },
        "inactive_arm_responses": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": { "$ref": "#/$defs/inactiveResponse" }
