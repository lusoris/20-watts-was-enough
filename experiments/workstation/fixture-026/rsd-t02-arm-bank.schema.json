  "properties": {
    "schema": { "const": 1 },
    "contract_version": { "const": "fixture-026.rsd-t02-arm-bank.v1" },
    "artifact": { "const": "fixture-026" },
    "track": { "const": "RSD-T02" },
    "profile": { "enum": ["smoke", "development"] },
    "partition": { "const": "public-development" },
    "active_arm_ids": {
      "const": ["B-STATE-SPACE", "B-RECURRENT", "C-MECHANISM-BANK"]
    },
    "inactive_arm_ids": {
      "const": ["A-RAW", "B-STATIC-DIV", "B-STREAM", "B-LOG-RATIO", "B-DIFFERENCE", "C-DUAL"]
