{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://20-watts-was-enough.local/schemas/workstation-manifest.schema.json",
  "title": "20 Watts Was Enough workstation experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact",
    "readiness",
    "command",
    "environment",
    "hardware",
    "seeds",
    "data",
    "outputs",
    "implementation",
    "energy",
    "resume"
  ],
  "properties": {
    "schema": { "const": 1 },
    "artifact": { "type": "string", "pattern": "^(candidate|fixture)-[0-9]{3}$" },
    "readiness": {
      "enum": ["scaffold", "smoke-ready", "workstation-ready"]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prepare", "smoke", "run", "analyze", "validate"],
      "properties": {
        "prepare": { "type": "string", "minLength": 1 },
        "smoke": { "type": "string", "minLength": 1 },
        "run": { "type": "string", "minLength": 1 },
        "analyze": { "type": "string", "minLength": 1 },
        "validate": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "required": ["runtime", "lockfiles"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "lockfiles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hardware": {
      "type": "object",
      "required": ["smoke", "workstation"],
      "properties": {
        "smoke": { "type": "object" },
        "workstation": { "type": "object" }
      }
    },
    "seeds": {
      "type": "object",
      "required": ["development", "confirmation", "held_out"],
      "properties": {
        "development": { "type": "string", "minLength": 1 },
        "confirmation": { "type": "string", "minLength": 1 },
        "held_out": { "type": "string", "minLength": 1 }
      }
    },
    "data": {
      "type": "object",
      "required": ["generator"],
      "properties": {
        "generator": { "type": "string", "minLength": 1 },
        "full_profile": { "type": "string", "minLength": 1 },
        "external": { "type": "array" }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["directory", "schema", "append_only", "hash_chain"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "append_only": { "const": true },
        "hash_chain": { "type": "boolean" }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["entrypoint", "tests", "full_tests"],
      "properties": {
        "entrypoint": { "type": "string", "minLength": 1 },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "full_tests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "energy": {
      "type": "object",
      "required": ["mode", "required"],
      "properties": {
        "mode": { "type": "string" },
        "required": { "type": "boolean" },
        "provider_config": { "type": "string" }
      }
    },
    "resume": {
      "type": "object",
      "required": ["supported"],
      "properties": {
        "supported": { "type": "boolean" }
      }
    }
  }
}
