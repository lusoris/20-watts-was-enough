{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://20-watts-was-enough.local/schemas/candidate-010-seed-release-artifacts-v1.json",
  "title": "Candidate 010 seed-release repository artifacts",
  "description": "Exact repository-visible shapes for pending commitments, operator commitments, frozen reveals, release plans, and reveal attestations. Encrypted escrow remains outside the repository and is validated by executable code.",
  "oneOf": [
    { "$ref": "#/definitions/pendingCommitment" },
    { "$ref": "#/definitions/sealedCommitment" },
    { "$ref": "#/definitions/frozenReveal" },
    { "$ref": "#/definitions/releasePlan" },
    { "$ref": "#/definitions/revealAttestation" }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "partition": {
      "enum": ["confirmation", "held-out"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "generationMethod": {
      "enum": ["system-cryptographic-entropy-v1", "injected-fixture-entropy-v1"]
    },
    "pendingCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "partition",
        "state",
        "algorithm",
        "seed_count",
        "commitment",
        "reveal",
        "note"
      ],
      "properties": {
        "schema": { "const": 1 },
        "partition": { "$ref": "#/definitions/partition" },
        "state": { "const": "pending-implementation-freeze" },
        "algorithm": { "const": "sha256-json-array-v1" },
        "seed_count": { "type": "null" },
        "commitment": { "type": "null" },
        "reveal": { "type": "null" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "sealedCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "partition",
        "state",
        "algorithm",
        "seed_count",
        "commitment",
        "operator_contract_version",
        "release_set_id",
        "freeze_identity_sha256",
        "claim_eligible",
        "generation_method"
      ],
      "properties": {
        "schema": { "const": 1 },
        "partition": { "$ref": "#/definitions/partition" },
        "state": { "const": "sealed" },
        "algorithm": { "const": "sha256-json-array-v1" },
        "seed_count": { "type": "integer", "minimum": 1 },
        "commitment": { "$ref": "#/definitions/sha256" },
        "operator_contract_version": { "const": "candidate-010.seed-release-operator.v1" },
        "release_set_id": { "$ref": "#/definitions/sha256" },
        "freeze_identity_sha256": { "$ref": "#/definitions/sha256" },
        "claim_eligible": { "type": "boolean" },
        "generation_method": { "$ref": "#/definitions/generationMethod" }
      }
    },
    "frozenReveal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "partition",
        "state",
        "algorithm",
        "commitment",
        "seeds",
        "operator_contract_version",
        "release_set_id",
        "plan_sha256",
        "claim_eligible"
      ],
      "properties": {
        "schema": { "const": 1 },
        "partition": { "$ref": "#/definitions/partition" },
        "state": { "const": "frozen-reveal" },
        "algorithm": { "const": "sha256-json-array-v1" },
        "commitment": { "$ref": "#/definitions/sha256" },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/seed" }
        },
        "operator_contract_version": { "const": "candidate-010.seed-release-operator.v1" },
        "release_set_id": { "$ref": "#/definitions/sha256" },
        "plan_sha256": { "$ref": "#/definitions/sha256" },
        "claim_eligible": { "type": "boolean" }
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bundle",
        "execution_descriptor",
        "runtime_identity",
        "config",
        "design",
        "backend_registry",
        "preregistration"
      ],
      "properties": {
        "source_bundle": { "$ref": "#/definitions/fileBinding" },
        "execution_descriptor": { "$ref": "#/definitions/fileBinding" },
        "runtime_identity": { "$ref": "#/definitions/fileBinding" },
        "config": { "$ref": "#/definitions/fileBinding" },
        "design": { "$ref": "#/definitions/fileBinding" },
        "backend_registry": { "$ref": "#/definitions/fileBinding" },
        "preregistration": { "$ref": "#/definitions/fileBinding" }
      }
    },
    "partitionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment_path", "seed_count", "commitment", "escrow_sha256"],
      "properties": {
        "commitment_path": { "type": "string", "pattern": "^(confirmation|held-out)\\.commit\\.json$" },
        "seed_count": { "type": "integer", "minimum": 1 },
        "commitment": { "$ref": "#/definitions/sha256" },
        "escrow_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "releasePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_version",
        "state",
        "artifact",
        "release_set_id",
        "release_version",
        "claim_eligible",
        "generation_method",
        "source_identity",
        "execution_identity",
        "runtime_identity",
        "bindings",
        "partitions",
        "cross_partition",
        "plan_sha256"
      ],
      "properties": {
        "schema": { "const": 1 },
        "contract_version": { "const": "candidate-010.seed-release-plan.v1" },
        "state": { "const": "commitments-sealed" },
        "artifact": { "const": "candidate-010" },
        "release_set_id": { "$ref": "#/definitions/sha256" },
        "release_version": { "type": "integer", "minimum": 1 },
        "claim_eligible": { "type": "boolean" },
        "generation_method": { "$ref": "#/definitions/generationMethod" },
        "source_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_sha256", "source_commit"],
          "properties": {
            "source_sha256": { "$ref": "#/definitions/sha256" },
            "source_commit": { "$ref": "#/definitions/sourceCommit" }
          }
        },
        "execution_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["descriptor_sha256", "source_inventory_sha256", "dependency_inventory_sha256"],
          "properties": {
            "descriptor_sha256": { "$ref": "#/definitions/sha256" },
            "source_inventory_sha256": { "$ref": "#/definitions/sha256" },
            "dependency_inventory_sha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity_sha256", "executable_sha256", "package_lock_sha256"],
          "properties": {
            "identity_sha256": { "$ref": "#/definitions/sha256" },
            "executable_sha256": { "$ref": "#/definitions/sha256" },
            "package_lock_sha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "bindings": { "$ref": "#/definitions/bindings" },
        "partitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmation", "held-out"],
          "properties": {
            "confirmation": { "$ref": "#/definitions/partitionPlan" },
            "held-out": { "$ref": "#/definitions/partitionPlan" }
          }
        },
        "cross_partition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["freeze_identity_sha256", "uniqueness_rule", "total_seed_count"],
          "properties": {
            "freeze_identity_sha256": { "$ref": "#/definitions/sha256" },
            "uniqueness_rule": { "const": "one jointly generated unsigned-32-bit set split once; duplicates refused" },
            "total_seed_count": { "type": "integer", "minimum": 2 }
          }
        },
        "plan_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "attestedPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment", "seed_count", "reveal_sha256"],
      "properties": {
        "commitment": { "$ref": "#/definitions/sha256" },
        "seed_count": { "type": "integer", "minimum": 1 },
        "reveal_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "revealAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "contract_version",
        "state",
        "artifact",
        "release_set_id",
        "plan_sha256",
        "claim_eligible",
        "partitions",
        "disjointness",
        "attestation_sha256"
      ],
      "properties": {
        "schema": { "const": 1 },
        "contract_version": { "const": "candidate-010.seed-reveal-attestation.v1" },
        "state": { "const": "explicitly-revealed" },
        "artifact": { "const": "candidate-010" },
        "release_set_id": { "$ref": "#/definitions/sha256" },
        "plan_sha256": { "$ref": "#/definitions/sha256" },
        "claim_eligible": { "type": "boolean" },
        "partitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmation", "held-out"],
          "properties": {
            "confirmation": { "$ref": "#/definitions/attestedPartition" },
            "held-out": { "$ref": "#/definitions/attestedPartition" }
          }
        },
        "disjointness": { "const": "verified" },
        "attestation_sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
