        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload_sha256"],
          "properties": {
            "payload_sha256": { "$ref": "#/definitions/hash" }
          }
        }
      }
    }
  },
  "required": [
    "schema", "ledger_contract_version", "artifact", "track", "claim_scope",
    "run_id", "profile", "partition", "seed", "world_index", "world_id",
    "generator_family", "arm", "work_key", "construction", "result_label",
    "no_result", "measured_energy_present", "energy_conclusion_allowed",
    "comparison_inference_permitted", "claim_eligible", "scientific_result",
    "performance_result", "integrity"
  ],
  "properties": {
    "schema": { "const": 1 },
    "ledger_contract_version": {
      "const": "fixture-029.cmb-x01-public-development-ledger-event.v3"
    },
    "artifact": { "const": "fixture-029" },
    "track": { "const": "CMB-X01" },
    "claim_scope": { "$ref": "#/definitions/claimScope" },
    "run_id": { "$ref": "#/definitions/hash" },
    "profile": { "$ref": "#/definitions/profile" },
    "partition": { "const": "public-development-only" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "world_index": { "type": "integer", "minimum": 0, "maximum": 63 },
    "world_id": { "$ref": "#/definitions/hash" },
    "generator_family": { "$ref": "#/definitions/family" },
